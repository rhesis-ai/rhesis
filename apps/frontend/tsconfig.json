{
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@testing-library/react-original": [
        "./node_modules/@testing-library/react"
      ],
      // Point at the file each package's "exports" resolves to. A bare directory makes
      // webpack pick "main"/"module" for app files while EE files (reached through
      // node_modules) get "exports", bundling two copies with two React contexts.
      "@mui/material": ["./node_modules/@mui/material/esm/index"],
      "@mui/material/*": ["./node_modules/@mui/material/esm/*"],
      "@mui/icons-material": ["./node_modules/@mui/icons-material/esm/index"],
      "@mui/icons-material/*": ["./node_modules/@mui/icons-material/esm/*"],
      "@mui/x-data-grid": ["./node_modules/@mui/x-data-grid"],
      "@tanstack/react-query": [
        "./node_modules/@tanstack/react-query/build/modern/index"
      ],
      "next/*": ["./node_modules/next/*"],
      "next-auth": ["./node_modules/next-auth"],
      "next-auth/*": ["./node_modules/next-auth/*"]
    },
    "target": "ES2017",
    "typeRoots": ["./node_modules/@types", "./types"],
    "baseUrl": "."
  },
  "include": [
    "next-env.d.ts",
    "types/*.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules", "e2e", "playwright.config.ts"]
}
