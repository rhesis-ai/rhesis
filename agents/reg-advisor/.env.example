# Required: Gemini API key (also accepts GEMINI_API_KEY)
GOOGLE_API_KEY=

# Optional: Gemini model id (default: gemini-3.1-flash-lite)
REG_ADVISOR_MODEL=gemini-3.1-flash-lite

# Set both to ship traces to the Rhesis backend. Without them the app runs
# normally and telemetry stays off.
RHESIS_API_KEY=
RHESIS_PROJECT_ID=

# Optional: point the SDK at a self-hosted or local backend.
# RHESIS_BASE_URL=http://localhost:8080
