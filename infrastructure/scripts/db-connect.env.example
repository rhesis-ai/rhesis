# Copy this file to `db-connect.env` (same directory, gitignored) and
# fill in your actual values. db-connect.sh refuses to run without that
# file present. Values below are placeholders, not real environment names.

# Kubernetes namespace all three Postgres deployments live in.
NAMESPACE="your-namespace"

# --- dev: Bitnami PostgreSQL chart, single pod/service (not CNPG) ----------
DEV_PROJECT="your-dev-gcp-project-id"
DEV_REGION="your-dev-region"
DEV_CLUSTER="your-dev-gke-cluster-name"
DEV_CONTEXT="gke_<dev-project>_<dev-region>_<dev-cluster>"
DEV_SVC="your-dev-postgres-service-name"
DEV_DB_NAME="your-dev-db-name"
DEV_ANALYTICS_DB_NAME="your-dev-analytics-db-name"
DEV_SECRET_NAME="your-dev-app-secret-name"
DEV_ADMIN_USERNAME="your-dev-admin-username"
DEV_ADMIN_PASS_KEY="your-dev-admin-password-secret-key"
DEV_USER_USERNAME="your-dev-app-username"
DEV_USER_PASS_KEY="your-dev-app-password-secret-key"
DEV_ANALYTICS_USERNAME="your-dev-analytics-username"
DEV_ANALYTICS_PASS_KEY="your-dev-analytics-password-secret-key"

# --- stg: CloudNativePG cluster --------------------------------------------
STG_PROJECT="your-stg-gcp-project-id"
STG_REGION="your-stg-region"
STG_CLUSTER="your-stg-gke-cluster-name"
STG_CONTEXT="gke_<stg-project>_<stg-region>_<stg-cluster>"
STG_SVC="your-stg-postgres-rw-service-name"
STG_DB_NAME="your-stg-db-name"
STG_ANALYTICS_DB_NAME="your-stg-analytics-db-name"
STG_ADMIN_SECRET="your-stg-admin-credentials-secret-name"
STG_USER_SECRET="your-stg-user-credentials-secret-name"
STG_ANALYTICS_SECRET="your-stg-analytics-credentials-secret-name"

# --- prd: CloudNativePG cluster (private endpoint) -------------------------
PRD_PROJECT="your-prd-gcp-project-id"
PRD_REGION="your-prd-region"
PRD_CLUSTER="your-prd-gke-cluster-name"
PRD_CONTEXT="gke_<prd-project>_<prd-region>_<prd-cluster>"
PRD_SVC="your-prd-postgres-rw-service-name"
PRD_DB_NAME="your-prd-db-name"
PRD_ANALYTICS_DB_NAME="your-prd-analytics-db-name"
PRD_ADMIN_SECRET="your-prd-admin-credentials-secret-name"
PRD_USER_SECRET="your-prd-user-credentials-secret-name"
PRD_ANALYTICS_SECRET="your-prd-analytics-credentials-secret-name"
