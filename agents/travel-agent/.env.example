# Gemini key (GEMINI_API_KEY also accepted). The only credential the agent needs -
# every travel service it calls is keyless.
GOOGLE_API_KEY=

# Optional: override the model.
TRAVEL_AGENT_MODEL=gemini-3.1-flash-lite

# Optional: force service failures to exercise the degradation paths without
# unplugging anything. Format: <service>:<timeout|error|empty>, comma-separated.
# Services: places, sights, dining, weather, transit, lodging
# TRAVEL_AGENT_FAULTS=weather:timeout,transit:error

# Set both to ship traces to the Rhesis backend.
RHESIS_API_KEY=
RHESIS_PROJECT_ID=
