# Required: Gemini API key (also accepts GEMINI_API_KEY)
GOOGLE_API_KEY=

# Optional: Gemini model id (default: gemini-3.1-flash-lite)
VISIT_PREP_MODEL=gemini-3.1-flash-lite

# Optional: Rhesis tracing (set both to ship traces to the Rhesis backend)
RHESIS_API_KEY=
RHESIS_PROJECT_ID=

# Optional: Rhesis backend + frontend URLs for traced entrypoints.
# RHESIS_BASE_URL is where spans are shipped; RHESIS_FRONTEND_URL builds
# clickable trace deep links in the Rhesis UI.
RHESIS_BASE_URL=http://localhost:8080
RHESIS_FRONTEND_URL=http://localhost:3000

# Required by traced entrypoints to capture span input/output content. Haystack reads this once,
# when it is imported, so it must be set before the process starts. The traced entrypoints set it
# for you; keep it here so a manual run or a different entry point gets it too.
HAYSTACK_CONTENT_TRACING_ENABLED=true

# Optional: export once per run as the root span closes (default: true). Set to false to leave
# exporting to the batch processor and flush on shutdown instead. The native integration also
# accepts the upstream name HAYSTACK_RHESIS_ENFORCE_FLUSH.
# RHESIS_HAYSTACK_ENFORCE_FLUSH=true
