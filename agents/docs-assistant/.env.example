# ── Model provider ────────────────────────────────────────────────────────────
# Gemini is the default. Switching provider is config only (see src/docs_assistant/models.py).
GOOGLE_API_KEY=
# DOCS_ASSISTANT_PROVIDER=gemini
# DOCS_ASSISTANT_MODEL=gemini-3.5-flash
# Triage sorts each message before any docs are read, so a small model is enough.
# DOCS_ASSISTANT_TRIAGE_MODEL=gemini-3.5-flash-lite
# DOCS_ASSISTANT_CRITIC_MODEL=gemini-3.5-flash

# OpenAI
# DOCS_ASSISTANT_PROVIDER=openai
# DOCS_ASSISTANT_MODEL=<openai model name>
# OPENAI_API_KEY=

# Anthropic (through its OpenAI-compatible endpoint)
# DOCS_ASSISTANT_PROVIDER=anthropic
# DOCS_ASSISTANT_MODEL=<claude model name>
# ANTHROPIC_API_KEY=

# Any other OpenAI-compatible endpoint (vLLM, Ollama, Groq, ...)
# DOCS_ASSISTANT_PROVIDER=openai_compatible
# DOCS_ASSISTANT_BASE_URL=http://localhost:11434/v1/
# DOCS_ASSISTANT_MODEL=<model name>
# DOCS_ASSISTANT_API_KEY=

# LiteLLM, for providers with no OpenAI-compatible endpoint (uv sync --extra litellm)
# DOCS_ASSISTANT_PROVIDER=litellm
# DOCS_ASSISTANT_MODEL=<provider>/<model>

# ── Docs source ──────────────────────────────────────────────────────────────
# DOCS_BASE_URL=https://docs.rhesis.ai
# DOCS_CACHE_TTL=3600
# DOCS_FETCH_TIMEOUT=10
# DOCS_PAGE_TIMEOUT=3

# ── Per-question limits ──────────────────────────────────────────────────────
# DOCS_ASSISTANT_MAX_TOOL_CALLS=10
# DOCS_ASSISTANT_MAX_PAGES=6
# DOCS_ASSISTANT_MAX_SEARCHES=5
# DOCS_ASSISTANT_MAX_TURNS=12
# DOCS_ASSISTANT_TURN_TIMEOUT=45
# DOCS_ASSISTANT_TOKEN_BUDGET=60000
# DOCS_ASSISTANT_PAGE_WINDOW_CHARS=24000
# Longer messages are cut, with a note in the reply.
# DOCS_ASSISTANT_MAX_INPUT_CHARS=2000
# Separate questions answered per message; the rest get a note.
# DOCS_ASSISTANT_MAX_PARTS=3
# Clarifying questions allowed in a row; after that the assistant must answer.
# DOCS_ASSISTANT_MAX_CLARIFY_STREAK=1
# Rejected drafts the model may fix before only its grounded claims are kept.
# DOCS_ASSISTANT_MAX_RETRIES=2

# ── Critic ───────────────────────────────────────────────────────────────────
# A second model call checks each claim against the text it cites, and can veto it.
# "off" saves a call per answer; the code checks still run.
# DOCS_ASSISTANT_CRITIC=on

# ── Conversations ────────────────────────────────────────────────────────────
# Held in memory (256 at most); idle ones are dropped after this many seconds.
# DOCS_ASSISTANT_SESSION_TTL=1800

# ── Server ───────────────────────────────────────────────────────────────────
# DOCS_ASSISTANT_PORT=8893

# ── Rhesis platform (optional) ───────────────────────────────────────────────
# With both set, /chat registers as the Rhesis endpoint "docs_assistant_chat" and every turn is
# shipped as a trace. Without them the app runs the same, untraced.
# RHESIS_API_KEY=
# RHESIS_PROJECT_ID=
# RHESIS_BASE_URL=http://localhost:8080        # a local ./rh dev stack; omit for app.rhesis.ai
# RHESIS_DISABLE_CONTENT_CAPTURE=1              # keep prompts and tool I/O out of the traces
